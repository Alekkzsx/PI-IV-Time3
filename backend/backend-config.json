{
  "_description": "Configuração dos serviços por contexto delimitado: Identidade/Videochamada Java (server/) e Núcleo Acadêmico TypeScript (backend/).",
  "environment": {
    "profile": "development",
    "orchestrator": "java_identity_videocall_and_typescript_academic_core"
  },
  "modules": {
    "server": {
      "path": "../server",
      "entrypoint": "Main",
      "port": 8080,
      "protocol": "HTTP/1.1",
      "auto_start": true,
      "healthcheck": "http://127.0.0.1:8080/health",
      "features": [
        "institutional_login",
        "two_factor_totp",
        "jwt_hs256_session_validation",
        "password_recovery_otp",
        "admin_user_lifecycle",
        "videocall_room_tickets",
        "videocall_webrtc_signaling",
        "videocall_chat_hub_sync",
        "academic_boletim_calculation",
        "academic_attendance_tracking",
        "academic_task_grading"
      ]
    },
    "academic_api": {
      "path": ".",
      "entrypoint": "npm run dev",
      "port": 3001,
      "protocol": "HTTP/1.1",
      "auto_start": false,
      "healthcheck": "http://127.0.0.1:3001/health",
      "features": [
        "passive_jwt_session_check",
        "academic_admin_operations",
        "student_dashboard",
        "teacher_dashboard",
        "academic_files",
        "internal_academic_bridge",
        "mongodb_academic_persistence"
      ]
    },
    "security": {
      "path": "../security",
      "package": "agmrm_security",
      "auto_bind": true,
      "features": [
        "generic_feedback_policy",
        "rate_limiting_lockout",
        "input_sanitizer",
        "timing_attack_mitigation"
      ]
    },
    "backend_persistence": {
      "database": "mongodb",
      "status": "configured_by_environment"
    }
  },
  "flutter_run_hook": {
    "enabled": true,
    "strategy": "dual_trigger_cmake_and_dart_vm",
    "description": "O servidor Java acadêmico e de sinalização é iniciado pelo launcher do frontend. O serviço TypeScript em backend/ é iniciado separadamente com 'cd backend; npm run dev'."
  }
}

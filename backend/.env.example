# Copie para .env.local e preencha os segredos localmente.
NODE_ENV=development
AUTH_PORT=3001
AUTH_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
MONGODB_URI=
MONGODB_DATABASE=agmrm
# Opcional se o DNS local recusar as consultas SRV:
MONGODB_DNS_SERVERS=
AUTH_JWT_SECRET=
AUTH_OTP_SECRET=
AUTH_JWT_TTL=15m
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=3
# Preencha todos os campos SMTP abaixo para enviar códigos reais.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Apenas para a execução explícita do seed:
SEED_DEMO_PASSWORD=

# Copie para .env.local e preencha com valores do ambiente; nunca versione segredos.
NODE_ENV=development
AUTH_PORT=3001
AUTH_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=pi_iv_time3
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_OTP_SECRET=replace-with-a-different-random-secret-at-least-32-characters
AUTH_JWT_TTL=15m
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=3
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

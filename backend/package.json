  "version": "1.0.0",
  "private": true,
  "description": "Serviço modular de autenticação institucional em TypeScript.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "create-user": "tsx src/scripts/create-auth-user.ts",

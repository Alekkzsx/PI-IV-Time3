# =============================================================================
# AGMRM Educational Platform — Master Environment Template (.env-example)
# =============================================================================
# Copie este arquivo para '.env' na raiz do projeto e preencha os valores:
#   cp .env-example .env
# AVISO: NUNCA realize commit do arquivo '.env' contendo credenciais reais!
# =============================================================================

# ─── 1. AMBIENTE E EXECUÇÃO GERAL ───
NODE_ENV=

# ─── 2. SERVIDOR DE AUTENTICAÇÃO E API (backend/ - TypeScript / Express na porta 3001) ───
AUTH_PORT=
AUTH_API_BASE_URL=
AUTH_CORS_ORIGINS=

# ─── 3. PERSISTÊNCIA E BANCO DE DADOS NOSQL (MongoDB Atlas / Local) ───
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_DNS_SERVERS=

# ─── 4. CRIPTOGRAFIA, SESSÕES E TOKENS JWT (RFC 7519) ───
AUTH_JWT_SECRET=
JWT_SECRET=
JWT_ALGORITHM=
AUTH_JWT_TTL=
JWT_ACCESS_TOKEN_TTL_SECONDS=
JWT_REFRESH_TOKEN_TTL_SECONDS=
TOKEN_ENCRYPTION_KEY=

# ─── 5. CICLO DE VIDA DO TOKEN EFÊMERO DE RECUPERAÇÃO (OTP / 2FA) ───
AUTH_OTP_SECRET=
AUTH_OTP_TTL_SECONDS=
RECOVERY_TOKEN_TTL_SECONDS=
AUTH_OTP_MAX_ATTEMPTS=
MAX_VERIFICATION_ATTEMPTS=
MAX_INVALID_OTP_ATTEMPTS=
OTP_CODE_LENGTH=

# ─── 6. SENHA DE SEED E PROVISIONAMENTO DEMO ───
SEED_DEMO_PASSWORD=

# ─── 7. DISPARO REAL DE E-MAILS (SMTP / GMAIL / WEBHOOK) ───
GMAIL_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_SSL=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── 8. SERVIDOR HTTP & WEBSOCKET NATIVO (server/ - Java SE na porta 8080) ───
SERVER_PORT=
SERVER_HOST=
JAVA_SERVER_BASE_URL=
REQUEST_TIMEOUT_SECONDS=
SERVER_THREAD_POOL_SIZE=
REQUIRE_HTTP_JWT=
VERIFY_REMOTE_SESSION=

# ─── 9. FRONTEIRA DE PAYLOAD E REQUISIÇÕES (HTTP 413) ───
MAX_BODY_SIZE_KB=
MAX_REQUEST_BODY_SIZE_BYTES=

# ─── 10. GOVERNANÇA DE CORS (CROSS-ORIGIN RESOURCE SHARING) ───
ALLOWED_ORIGINS=
ALLOWED_ORIGIN=
CORS_ORIGIN=
CORS_ALLOWED_METHODS=
CORS_ALLOW_METHODS=
CORS_ALLOWED_HEADERS=
CORS_ALLOW_HEADERS=
CORS_MAX_AGE_SECONDS=

# ─── 11. CABEÇALHOS DEFENSIVOS HTTP (SECURITY HEADERS) ───
HEADER_X_CONTENT_TYPE_OPTIONS=
HEADER_X_FRAME_OPTIONS=
HEADER_X_XSS_PROTECTION=
HEADER_STRICT_TRANSPORT_SECURITY=
HEADER_CONTENT_SECURITY_POLICY=

# ─── 12. DEFESA CONTRA FORÇA BRUTA E RATE LIMITING (security/) ───
MAX_FAILED_LOGIN_ATTEMPTS=
LOCKOUT_DURATION_SECONDS=

# ─── 13. MITIGAÇÃO DE ATAQUES DE TEMPORIZAÇÃO (TIMING ATTACKS) ───
STANDARDIZED_AUTH_LATENCY_MS=
STANDARD_AUTH_LATENCY_MS=
STANDARDIZED_AUTH_JITTER_MS=

# ─── 14. POLÍTICA DE COMPLEXIDADE E ENTROPIA DE SENHAS ───
PASSWORD_MIN_LENGTH=
MIN_PASSWORD_LENGTH=
PASSWORD_MAX_LENGTH=
MAX_PASSWORD_LENGTH=
PASSWORD_MIN_ENTROPY_SCORE=
MIN_PASSWORD_ENTROPY_SCORE=
REQUIRE_UPPERCASE=
REQUIRE_LOWERCASE=
REQUIRE_DIGIT=
REQUIRE_SPECIAL_CHAR=

# ─── 15. PERSISTÊNCIA RELACIONAL SECUNDÁRIA (OPCIONAL) ───
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# ─── 16. FRONTEND FLUTTER E ROTAS (frontend/) ───
INITIAL_ROUTE=
API_BASE_URL=
FLUTTER_WEB_PORT=

# ─── 17. VIDEOCHAMADA INSTITUCIONAL E WEBRTC P2P ───
VIDEOCALL_SIGNALING_URL=
VIDEOCALL_ROOMS_URL=
VIDEOCALL_HEARTBEAT_INTERVAL_SECONDS=
VIDEOCALL_MAX_PEERS_PER_ROOM=
STUN_SERVER_URL=

# ─── 18. REGRAS ACADÊMICAS E GOVERNANÇA REGIMENTAL ───
ACADEMIC_MIN_ATTENDANCE_PERCENTAGE=
LATE_ASSIGNMENT_PENALTY_RATE=
CONSEPE_REGIMENTAL_LOCK_ENABLED=

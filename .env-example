# =============================================================================
# AGMRM Educational Platform — Unified Master Environment Configuration Template
# =============================================================================
# Arquivo mestre centralizado contendo todas as variáveis de ambiente do projeto.
# Copie este arquivo para '.env' na raiz do projeto:
#   cp .env-example .env
# AVISO DE SEGURANÇA: NUNCA realize commit do arquivo '.env' contendo segredos reais!
# =============================================================================

# ─── 1. AMBIENTE E EXECUÇÃO GERAL ───
NODE_ENV=development

# ─── 2. SERVIDOR DE AUTENTICAÇÃO E API (backend/ - TypeScript / Express na porta 3001) ───
AUTH_PORT=3001
AUTH_API_BASE_URL=http://127.0.0.1:3001
AUTH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# ─── 3. PERSISTÊNCIA E BANCO DE DADOS NOSQL (MongoDB Atlas / Local) ───
MONGODB_URI=mongodb://localhost:27017/agmrm
MONGODB_DATABASE=agmrm
# Opcional caso a rede bloqueie consultas DNS SRV:
MONGODB_DNS_SERVERS=

# ─── 4. CRIPTOGRAFIA, SESSÕES E TOKENS JWT (RFC 7519) ───
# Segredo compartilhado de assinatura HS256 para backend e server Java (mínimo 32 caracteres):
AUTH_JWT_SECRET=super_secret_high_entropy_signing_key_at_least_32_chars_2026
JWT_SECRET=super_secret_high_entropy_signing_key_at_least_32_chars_2026
JWT_ALGORITHM=HS256
AUTH_JWT_TTL=8h
JWT_ACCESS_TOKEN_TTL_SECONDS=28800
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
TOKEN_ENCRYPTION_KEY=CHANGEME_SECURE_EPHEMERAL_AES_GCM_256_BIT_SECRET_KEY

# ─── 5. CICLO DE VIDA DO TOKEN EFÊMERO DE RECUPERAÇÃO (OTP / 2FA) ───
AUTH_OTP_SECRET=another_super_secret_otp_signing_key_at_least_32_chars_2026
AUTH_OTP_TTL_SECONDS=300
RECOVERY_TOKEN_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=3
MAX_VERIFICATION_ATTEMPTS=3
MAX_INVALID_OTP_ATTEMPTS=3
OTP_CODE_LENGTH=6

# ─── 6. SENHA DE SEED E PROVISIONAMENTO DEMO ───
SEED_DEMO_PASSWORD=Agmrm@2026

# ─── 7. DISPARO REAL DE E-MAILS (SMTP / GMAIL / WEBHOOK) ───
GMAIL_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb_exemplo_sua_url_google_apps_script/exec
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_SSL=true
SMTP_USER=staff.notadez@gmail.com
SMTP_PASSWORD=sua-senha-de-app-16-caracteres
SMTP_FROM=staff.notadez@gmail.com

# ─── 8. SERVIDOR HTTP & WEBSOCKET NATIVO (server/ - Java SE na porta 8080) ───
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
JAVA_SERVER_BASE_URL=http://127.0.0.1:8080
REQUEST_TIMEOUT_SECONDS=30
SERVER_THREAD_POOL_SIZE=32
REQUIRE_HTTP_JWT=false
VERIFY_REMOTE_SESSION=false

# ─── 9. FRONTEIRA DE PAYLOAD E REQUISIÇÕES (HTTP 413) ───
MAX_BODY_SIZE_KB=64
MAX_REQUEST_BODY_SIZE_BYTES=65536

# ─── 10. GOVERNANÇA DE CORS (CROSS-ORIGIN RESOURCE SHARING) ───
ALLOWED_ORIGINS=*
ALLOWED_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost
CORS_ALLOWED_METHODS=GET, POST, PUT, DELETE, OPTIONS
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type, Authorization, X-Requested-With
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE_SECONDS=86400

# ─── 11. CABEÇALHOS DEFENSIVOS HTTP (SECURITY HEADERS) ───
HEADER_X_CONTENT_TYPE_OPTIONS=nosniff
HEADER_X_FRAME_OPTIONS=DENY
HEADER_X_XSS_PROTECTION=1; mode=block
HEADER_STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains
HEADER_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none';

# ─── 12. DEFESA CONTRA FORÇA BRUTA E RATE LIMITING (security/) ───
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=30

# ─── 13. MITIGAÇÃO DE ATAQUES DE TEMPORIZAÇÃO (TIMING ATTACKS) ───
STANDARDIZED_AUTH_LATENCY_MS=1000
STANDARD_AUTH_LATENCY_MS=1000
STANDARDIZED_AUTH_JITTER_MS=25

# ─── 14. POLÍTICA DE COMPLEXIDADE E ENTROPIA DE SENHAS ───
PASSWORD_MIN_LENGTH=8
MIN_PASSWORD_LENGTH=8
PASSWORD_MAX_LENGTH=128
MAX_PASSWORD_LENGTH=128
PASSWORD_MIN_ENTROPY_SCORE=3
MIN_PASSWORD_ENTROPY_SCORE=3
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true
REQUIRE_DIGIT=true
REQUIRE_SPECIAL_CHAR=true

# ─── 15. PERSISTÊNCIA RELACIONAL SECUNDÁRIA (OPCIONAL) ───
DATABASE_URL=jdbc:postgresql://localhost:5432/agmrm_db
DATABASE_USER=agmrm_secure_user
DATABASE_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ─── 16. FRONTEND FLUTTER E ROTAS (frontend/) ───
INITIAL_ROUTE=/
API_BASE_URL=http://localhost:8080
FLUTTER_WEB_PORT=3000

# ─── 17. VIDEOCHAMADA INSTITUCIONAL E WEBRTC P2P ───
VIDEOCALL_SIGNALING_URL=http://localhost:8080/api/videocall/signal
VIDEOCALL_ROOMS_URL=http://localhost:8080/api/videocall/rooms
VIDEOCALL_HEARTBEAT_INTERVAL_SECONDS=5
VIDEOCALL_MAX_PEERS_PER_ROOM=50
STUN_SERVER_URL=stun:stun.l.google.com:19302

# ─── 18. REGRAS ACADÊMICAS E GOVERNANÇA REGIMENTAL ───
ACADEMIC_MIN_ATTENDANCE_PERCENTAGE=75.0
LATE_ASSIGNMENT_PENALTY_RATE=0.20
CONSEPE_REGIMENTAL_LOCK_ENABLED=true

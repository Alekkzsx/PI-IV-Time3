{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGMRM_CORS_Policy_Configuration",
  "version": "1.0.0",
  "description": "Especificação formal de Cross-Origin Resource Sharing (CORS) para o Portal Acadêmico AGMRM",
  "environments": {
    "development": {
      "description": "Configuração permissiva para desenvolvimento local com Flutter Web e emuladores",
      "allowedOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "http://localhost:8080",
        "http://127.0.0.1:8080"
      ],
      "allowedMethods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "allowedHeaders": [
        "Content-Type",
        "Authorization",
        "X-Requested-With",
        "Accept",
        "Origin"
      ],
      "exposedHeaders": [
        "Content-Length",
        "Date",
        "X-Request-Id"
      ],
      "allowCredentials": true,
      "maxAgeSeconds": 3600
    },
    "staging": {
      "description": "Ambiente de homologação institucional em infraestrutura compartilhada",
      "allowedOrigins": [
        "https://staging-portal.agmrm.edu.br",
        "https://staging-api.agmrm.edu.br"
      ],
      "allowedMethods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "allowedHeaders": [
        "Content-Type",
        "Authorization",
        "X-Requested-With",
        "Accept"
      ],
      "exposedHeaders": [
        "Content-Length",
        "X-Request-Id"
      ],
      "allowCredentials": true,
      "maxAgeSeconds": 43200
    },
    "production": {
      "description": "Ambiente de produção com restrição estrita de origens autorizadas (Zero-Trust)",
      "allowedOrigins": [
        "https://portal.agmrm.edu.br"
      ],
      "allowedMethods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "allowedHeaders": [
        "Content-Type",
        "Authorization",
        "X-Requested-With",
        "Accept"
      ],
      "exposedHeaders": [
        "Content-Length",
        "X-Request-Id"
      ],
      "allowCredentials": true,
      "maxAgeSeconds": 86400
    }
  },
  "endpointsPolicy": {
    "/api/teste-tipos": {
      "requiresAuthentication": false,
      "allowedMethods": ["POST", "OPTIONS"]
    },
    "/api/presenca": {
      "requiresAuthentication": true,
      "allowedMethods": ["POST", "OPTIONS"],
      "allowedRoles": ["ALUNO", "PROFESSOR", "ADMIN"]
    },
    "/api/tarefas/calcular-nota": {
      "requiresAuthentication": true,
      "allowedMethods": ["POST", "OPTIONS"],
      "allowedRoles": ["PROFESSOR", "ADMIN"]
    },
    "/api/notas/boletim": {
      "requiresAuthentication": true,
      "allowedMethods": ["POST", "OPTIONS"],
      "allowedRoles": ["ALUNO", "PROFESSOR", "ADMIN"]
    }
  }
}

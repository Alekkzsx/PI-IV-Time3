# =============================================================================
# AGMRM Educational Platform — Security & Environment Configuration Template
# =============================================================================
# Copie este arquivo para 'security/.env' durante o desenvolvimento local.
# AVISO DE SEGURANÇA: NUNCA realize commit do arquivo '.env' ativo contendo segredos!
# =============================================================================

# ─── 1. SERVIDOR HTTP E REDE (R4) ───
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
REQUEST_TIMEOUT_SECONDS=30

# ─── 2. FRONTEIRA DE PAYLOAD E REQUISIÇÕES (HTTP 413) (R4) ───
MAX_BODY_SIZE_KB=64
MAX_REQUEST_BODY_SIZE_BYTES=65536

# ─── 3. GOVERNANÇA DE CORS (CROSS-ORIGIN RESOURCE SHARING) (R4) ───
ALLOWED_ORIGINS=*
ALLOWED_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost
CORS_ALLOWED_METHODS=GET, POST, PUT, DELETE, OPTIONS
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type, Authorization, X-Requested-With
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE_SECONDS=86400

# ─── 4. CABEÇALHOS DEFENSIVOS HTTP (R4) ───
HEADER_X_CONTENT_TYPE_OPTIONS=nosniff
HEADER_X_FRAME_OPTIONS=DENY
HEADER_X_XSS_PROTECTION=1; mode=block
HEADER_STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains
HEADER_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none';

# ─── 5. DEFESA CONTRA FORÇA BRUTA E RATE LIMITING (R2) ───
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=30

# ─── 6. MITIGAÇÃO DE ATAQUES DE TEMPORIZAÇÃO (TIMING ATTACKS) (R2) ───
STANDARDIZED_AUTH_LATENCY_MS=1000
STANDARD_AUTH_LATENCY_MS=1000
STANDARDIZED_AUTH_JITTER_MS=25

# ─── 7. CICLO DE VIDA DO TOKEN EFÊMERO DE RECUPERAÇÃO (R3) ───
RECOVERY_TOKEN_TTL_SECONDS=300
MAX_VERIFICATION_ATTEMPTS=3
MAX_INVALID_OTP_ATTEMPTS=3
OTP_CODE_LENGTH=6

# ─── 8. POLÍTICA DE COMPLEXIDADE E ENTROPIA DE SENHAS (R3) ───
PASSWORD_MIN_LENGTH=8
MIN_PASSWORD_LENGTH=8
PASSWORD_MAX_LENGTH=128
MAX_PASSWORD_LENGTH=128
PASSWORD_MIN_ENTROPY_SCORE=3
MIN_PASSWORD_ENTROPY_SCORE=3

# ─── 9. CRIPTOGRAFIA E TOKENS JWT (RFC 7519) ───
JWT_SECRET=super_secret_high_entropy_signing_key_at_least_32_chars_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
TOKEN_ENCRYPTION_KEY=CHANGEME_SECURE_EPHEMERAL_AES_GCM_256_BIT_SECRET_KEY

# ─── 10. PERSISTÊNCIA E BANCO DE DADOS (ISOLAMENTO DE AMBIENTE) ───
DATABASE_URL=jdbc:postgresql://localhost:5432/agmrm_db
DATABASE_USER=agmrm_secure_user
DATABASE_PASSWORD=CHANGE_ME_IN_PRODUCTION

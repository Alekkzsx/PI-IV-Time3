# =============================================================================
# AGMRM PORTAL ACADÊMICO - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# =============================================================================
# AVISO DE SEGURANÇA:
# NUNCA insira credenciais reais de produção neste arquivo de exemplo.
# Copie este arquivo para .env no ambiente de implantação e preencha com
# segredos fortes gerados criptograficamente.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AMBIENTE & CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# -----------------------------------------------------------------------------
APP_NAME="Portal Academico AGMRM"
APP_ENV=development                       # development | staging | production
APP_DEBUG=true                            # DEFINIR false OBRIGATORIAMENTE EM PRODUÇÃO
APP_URL=http://localhost:3000
APP_SECRET=alterar_para_chave_criptografica_minimo_32_bytes_hexadecimal

# -----------------------------------------------------------------------------
# 2. SERVIDOR RUNTIME HTTP NATIVO (PORTA 8080)
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0                       # 127.0.0.1 para restrição local ou 0.0.0.0 para proxy reverso
SERVER_PORT=8080                          # Porta de escuta oficial da aplicação Java
SERVER_BACKLOG=50                         # Tamanho da fila de conexões pendentes do HttpServer
SERVER_MAX_THREADS=16                     # Pool de threads para processamento concorrente
SERVER_MAX_REQUEST_BODY_BYTES=65536       # 64 KB - Limite máximo de corpo HTTP para prevenção de DoS
SERVER_READ_TIMEOUT_MS=10000              # 10 segundos de timeout de leitura de socket
SERVER_WRITE_TIMEOUT_MS=10000             # 10 segundos de timeout de escrita de socket

# -----------------------------------------------------------------------------
# 3. POLÍTICA DE CORS (CROSS-ORIGIN RESOURCE SHARING)
# -----------------------------------------------------------------------------
# Lista separada por vírgula de origens autorizadas a invocar os endpoints da API.
# Em desenvolvimento: origens locais de teste (Flutter Web dev server na 3000 ou porta alternativa).
# Em produção: OBRIGATÓRIO utilizar o domínio FQDN institucional com HTTPS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,https://portal.agmrm.edu.br
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=86400                # 24 horas de cache para requisições preflight OPTIONS

# -----------------------------------------------------------------------------
# 4. BANCO DE DADOS NOSQL (MONGODB)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agmrm_academico
MONGODB_USER=agmrm_app_user
MONGODB_PASSWORD=insira_senha_forte_do_banco_aqui
MONGODB_AUTH_SOURCE=admin
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=25
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# 5. AUTENTICAÇÃO JWT (JSON WEB TOKENS) & SESSÃO
# -----------------------------------------------------------------------------
JWT_SECRET=gerar_chave_hmac_sha256_com_minimo_256_bits_de_entropia
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600               # 1 hora para tokens de acesso da sessão do aluno/professor
JWT_REFRESH_EXPIRATION_SECONDS=604800     # 7 dias para tokens de refresh de sessão
JWT_ISSUER=agmrm-auth-service
JWT_AUDIENCE=agmrm-portal

# -----------------------------------------------------------------------------
# 6. POLÍTICA INSTITUCIONAL DE RECUPERAÇÃO DE SENHA E TOKENS TEMPORÁRIOS
# -----------------------------------------------------------------------------
# REGRA INSTITUCIONAL MANDATÓRIA (vide SecurityAlertBanner no frontend):
# Tokens de recuperação de senha possuem estritamente 5 minutos de validade.
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=5
PASSWORD_RESET_TOKEN_LENGTH_BYTES=32      # Entropia mínima de 256 bits (CSPRNG)
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5      # Máximo de tentativas de submissão do token antes do bloqueio
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_MAX_DAILY_REQUESTS=10      # Limite diário por RA/E-mail institucional

# -----------------------------------------------------------------------------
# 7. LOGGING, AUDITORIA & OBSERVABILIDADE
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                            # DEBUG | INFO | WARN | ERROR
LOG_FILE_PATH=logs/app.log
AUDIT_LOG_ENABLED=true                    # Registro de alterações em notas e faltas (LGPD e integridade)
AUDIT_LOG_FILE_PATH=logs/audit_academic.log
MASK_SENSITIVE_DATA_IN_LOGS=true          # Mascaramento de senhas, CPFs e tokens

# -----------------------------------------------------------------------------
# 8. TLS / SSL & HEADERS DE SEGURANÇA
# -----------------------------------------------------------------------------
SSL_ENABLED=false                         # Ativar em produção se não houver terminação TLS no proxy reverso
SSL_KEYSTORE_PATH=/etc/ssl/certs/keystore.p12
SSL_KEYSTORE_PASSWORD=senha_keystore_protegida
HSTS_ENABLED=true                         # Ativar HSTS via proxy reverso em produção
HSTS_MAX_AGE_SECONDS=31536000             # 1 ano

# -----------------------------------------------------------------------------
# 9. FRONTEND CLIENT (FLUTTER WEB)
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
FRONTEND_API_BASE_URL=http://localhost:8080

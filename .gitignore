# =============================================================================
# .gitignore — Padrão de Projeto Robusto e Seguro (AGMRM)
# =============================================================================

# ─── 1. Segredos e Variáveis de Ambiente (CRÍTICO: NUNCA COMMITAR) ───
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/

# Permitir exclusivamente o template mestre unificado de variáveis de ambiente
!.env-example

# ─── 2. Artefatos de Build e Cache das Pastas Mães (Flutter / Dart) ───
# Previne reinstalação ou download forçado de dependências entre máquinas
.dart_tool/
**/.dart_tool/
.flutter-plugins
**/.flutter-plugins
.flutter-plugins-dependencies
**/.flutter-plugins-dependencies
.packages
**/.packages
.pub-cache/
**/.pub-cache/
.pub/
**/.pub/
build/
**/build/

# Preservar o lockfile das dependências (garante paridade exata de versões)
!**/pubspec.lock
!lib/
!lib/**

# Artefatos nativos e efêmeros de plataformas
**/ephemeral/
**/windows/flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/ios/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Pods/
**/ios/.symlinks/
**/android/.gradle/
**/android/local.properties
**/android/app/build/
**/.cxx/
**/.externalNativeBuild/

# ─── 3. Artefatos de Compilação do Java e Backend (server/ e backend/) ───
server/bin/
**/bin/
*.class
**/*.class
*.jar
*.war
*.ear
backend/target/
**/.gradle/

# ─── 4. Dependências de Outros Ecossistemas (Node / Python / .NET) ───
node_modules/
jspm_packages/
.pnp
.pnp.js
__pycache__/
*.py[cod]
*$py.class
env/
venv/
.venv/
dist/
out/
coverage/
.nyc_output/
*.tsbuildinfo
obj/
*.suo
*.user

# ─── 5. Logs e Arquivos Temporários ───
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
*.bak
*.swp
*.swo

# ─── 6. Arquivos de Sistema Operacional ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── 7. Configurações de IDE e Editores ───
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.agents
.settings/
.history/
*.code-workspace

# VS Code compartilhado e institucional
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.github/.vscode/**

# ─── 8. Governança e Regras de CI/CD (NUNCA IGNORAR) ───
!.github/
